# ═══════════════════════════════════════════════════════════════
# AI Agent Backend — 环境变量配置
# 复制此文件为 .env 并填入你的真实 API Key
# ═══════════════════════════════════════════════════════════════

# ── API 密钥（必填）───────────────────────────────────────────
# DeepSeek: 在 platform.deepseek.com 申请
# OpenAI:   在 platform.openai.com 申请
OPENAI_API_KEY=sk-your-api-key-here

# ── API 地址 ──────────────────────────────────────────────────
# DeepSeek 官方（默认）
OPENAI_BASE_URL=https://api.deepseek.com
# OpenAI 官方（如使用则取消下一行注释，注释上一行）
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── 模型名称 ──────────────────────────────────────────────────
# DeepSeek: deepseek-chat 或 deepseek-reasoner
# OpenAI:   gpt-4o 或 gpt-4o-mini
MODEL_NAME=deepseek-chat

# ── 服务配置 ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
